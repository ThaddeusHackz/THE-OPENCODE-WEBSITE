    "@opencode/cli-linux-x64": "2.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
