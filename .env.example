# ---------------------------------------------------------------------------
# Example environment variables. NAMES AND DESCRIPTIONS ONLY — no real values.
# Copy to .env.local for local dev; set the same names in the Vercel dashboard.
# ---------------------------------------------------------------------------

# --- Supabase (safe to expose: anon key is a public, RLS-scoped key) ---------
# URL of your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key. Never use a service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OPTIONAL, server-side only. If set, /api/config reads /auth/v1/settings with this
# key to check whether the GitHub OAuth provider is enabled; otherwise the
# publishable anon key is used, with an authorize-endpoint probe as fallback.
# Never put this in NEXT_PUBLIC_*, the browser, logs or source control.
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub access (server-side only) ---------------------------------------
# PREFERRED: least-privilege GitHub App with only "Contents: read" and
# "Metadata: read". If these three are set, GITHUB_TOKEN is ignored.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# FALLBACK: a fine-grained PAT used ONLY on the server, never exposed to the
# browser, logs, localStorage or commits. Prefer the App for multi-user setups.
GITHUB_TOKEN=

# --- OpenCode runtime (server-side only) ------------------------------------
# Optional absolute path to an already-provisioned OpenCode v2 CLI binary.
# If unset, the adapter looks for the pinned npm platform package in node_modules.
OPENCODE_BINARY_PATH=
#
# NORMAL free models only. We deliberately do NOT use OpenCode Zen (the
# "opencode/*" promotional free tier, which returns `provider.free-limit` 429).
# The catalog at /api/models is generated from OpenCode's own bundled
# models.dev snapshot: zero-cost, tool-capable chat models from ordinary
# providers. Each model lists the credential env var NAME it needs; values are
# never returned to the browser and never stored here.
#
# Default: vercel/reflection/beam-free — a normal free model that needs NO new
# key on Vercel, because OpenCode's vercel-ai-gateway provider accepts the
# automatically injected VERCEL_OIDC_TOKEN. Set OPENCODE_MODEL to any id from
# /api/models (e.g. amd/DeepSeek-V4.1-Flash, openrouter/openrouter/free).
OPENCODE_MODEL=
# 1 (default) removes Zen's `opencode` / `opencode-go` free models from the
# child process entirely. Set 0 only if you explicitly want them back.
OPENCODE_DISABLE_FREE_MODELS=
# Set to 1 to enable the public, bounded verification route
# GET/POST /api/models/test?model=<provider>/<id>. Disable in production if unused.
ENABLE_MODEL_TESTS=
#
# Credential env var NAMES for normal free providers. Set only the one(s) for
# the provider you choose, as Sensitive/Encrypted Vercel env vars. The child
# process receives ONLY these allowlisted names — never GitHub, Supabase or
# Vercel project secrets. Do not paste values into chat or source control.
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN is injected by Vercel automatically; do not set it yourself.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
AMD_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=
COHERE_API_KEY=
GITLAB_TOKEN=
MODELSCOPE_API_KEY=
KILO_API_KEY=
REQUESTY_API_KEY=
ZHIPU_API_KEY=
# ...plus the other provider names shown per-model at /api/models.
# Legacy/paid providers (only needed for a non-catalog OPENCODE_MODEL):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Hard cap for one agent invocation in milliseconds (must be below the Vercel
# function maxDuration). Default 240000.
OPENCODE_TIMEOUT_MS=
# Max bytes of captured stdout/stderr (default 200000).
OPENCODE_MAX_OUTPUT_BYTES=
# Max bytes of a downloaded repository archive (default 50000000).
OPENCODE_MAX_REPO_BYTES=

# --- Vercel / deployment ----------------------------------------------------
# Node.js major used by Vercel builds and Functions (22.x, 24.x or 26.x).
# Set in package.json engines; no env value required.
# For the 241 MB OpenCode binary, enable Large Functions (Fluid compute) with:
# VERCEL_SUPPORT_LARGE_FUNCTIONS=1
